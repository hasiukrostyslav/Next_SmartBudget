# Copy to .env and fill in. Both are checked at startup (src/lib/envSchema.ts).

# Postgres connection URL. A Neon URL's sslmode=require is upgraded to
# verify-full; a local database can use ?sslmode=disable.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# At least 32 characters. Generate one with: npx auth secret
AUTH_SECRET=

# Optional, for `npx prisma db seed`: the existing account to add sample
# transactions to.
# SEED_USER_EMAIL=you@example.com
