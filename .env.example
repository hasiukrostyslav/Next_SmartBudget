# Copy to .env and fill in. Both are checked at startup (src/lib/envSchema.ts).

# Postgres connection URL. A Neon URL's sslmode=require is upgraded to
# verify-full; a local database can use ?sslmode=disable.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# At least 32 characters. Generate one with: npx auth secret
AUTH_SECRET=

# Optional. How many proxies in front of the app append to X-Forwarded-For
# (default 1: Vercel, or one reverse proxy). Sign-in and sign-up limits key a
# client on the address the outermost trusted proxy saw. Run the app behind a
# proxy: on its own, Next.js keeps an X-Forwarded-For header the client sent.
# TRUSTED_PROXY_HOPS=1

# Optional, for `npx prisma db seed`: the existing account to add sample
# transactions to.
# SEED_USER_EMAIL=you@example.com
